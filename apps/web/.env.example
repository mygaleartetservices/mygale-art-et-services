NODE_ENV=development

PORT=3000
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-change-this-in-production-use-openssl-rand-base64-32"
NEXTAUTH_URL=

# Database
DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Email Provider Configuration
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

NEXTAUTH_SECRET=
NEXTAUTH_URL=
API_JWT_PRIVATE_KEY=
API_JWT_PUBLIC_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_API_URL=
POSTGRES_USER=--
POSTGRES_PASSWORD=--
POSTGRES_DB=--
NEXT_DISABLE_TURBOPACK=1

# AWS S3 settings for uploads
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# CDN and CloudFront signing settings
CDN_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
