CLOUDFRONT_COOKIE_TTL_SECONDS=
FRONTEND_URL=

# Secret used to sign the rotating token embedded in the attendance QR code
# (falls back to NEXTAUTH_SECRET, then DATABASE_URL, if unset — set this
# explicitly in production)
ATTENDANCE_QR_SECRET=