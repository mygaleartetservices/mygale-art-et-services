{
  "name": "mygale-art-et-services",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@10.29.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "sync-env": "node scripts/sync-env.js",
    "dev:web": "cd apps/web && pnpm run dev",
    "dev:api": "cd apps/api && pnpm run start:dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev": "node scripts/dev-with-cleanup.js",
    "db:seed": "pnpm exec prisma db seed --schema packages/prisma/prisma/schema.prisma",
    "db:seed:cms": "pnpm --filter @mygale/prisma run db:seed:cms",
    "db:generate": "pnpm exec prisma generate --schema packages/prisma/prisma/schema.prisma",
    "db:push": "pnpm exec prisma db push --schema packages/prisma/prisma/schema.prisma",
    "db:studio": "pnpm exec prisma studio --schema packages/prisma/prisma/schema.prisma",
    "db:migrate": "pnpm exec prisma migrate dev --schema packages/prisma/prisma/schema.prisma",
    "db:migrate:ci": "pnpm exec prisma migrate dev --name auto_migration --skip-generate --schema packages/prisma/prisma/schema.prisma",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy --schema packages/prisma/prisma/schema.prisma",
    "db:reset": "pnpm run db:down && pnpm run db:up && pnpm exec prisma migrate deploy --schema packages/prisma/prisma/schema.prisma && pnpm exec prisma generate --schema packages/prisma/prisma/schema.prisma",
    "build:web": "cd apps/web && pnpm run build",
    "build:api": "cd apps/api && pnpm run build",
    "build": "pnpm exec turbo run build",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "pnpm exec turbo run test --parallel",
    "test:api": "cd apps/api && pnpm run test"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@dnd-kit/accessibility": "^3.1.1",
    "@prisma/client": "^6.19.0",
    "@ungap/structured-clone": "^1.3.0",
    "@vercel/analytics": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "ccount": "^2.0.1",
    "character-entities": "^2.0.2",
    "comma-separated-tokens": "^2.0.3",
    "mdast-util-find-and-replace": "^3.0.2",
    "micromark-util-character": "^2.1.1",
    "dequal": "^2.0.3",
    "devlop": "^1.1.0",
    "dompurify": "^3.4.13",
    "estree-util-is-identifier-name": "^3.0.0",
    "framer-motion": "^12.43.0",
    "glob": "^12.0.0",
    "hast-util-from-parse5": "^8.0.3",
    "hast-util-parse-selector": "^4.0.0",
    "hast-util-raw": "^9.1.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-parse5": "^8.0.1",
    "hast-util-whitespace": "^3.0.0",
    "hastscript": "^9.0.1",
    "html-void-elements": "^3.0.0",
    "inline-style-parser": "^0.2.7",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-numeric-character-reference": "^2.0.2",
    "minimist": "^1.2.8",
    "motion-dom": "^12.43.0",
    "motion-utils": "^12.39.0",
    "next": "16.3.7",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.13",
    "parse5": "^8.0.0",
    "property-information": "^7.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rimraf": "^6.1.0",
    "socket.io-client": "^4.8.1",
    "space-separated-tokens": "^2.0.2",
    "style-to-js": "^1.1.21",
    "style-to-object": "^1.0.14",
    "unified": "^11.0.5",
    "unist-util-position": "^5.0.0",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vfile-location": "^5.0.3",
    "vfile-message": "^4.0.3",
    "web-namespaces": "^2.0.1",
    "zod": "^4.1.12",
    "zwitch": "^2.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "8.2.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.0.0",
    "prisma": "^6.19.0",
    "turbo": "^2.6.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.3",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.26",
      "sharp": ">=0.35.5",
      "turbo": ">=2.9.14",
      "effect": ">=3.20.0",
      "brace-expansion": ">=5.0.11",
      "js-yaml": ">=4.3.1",
      "fast-xml-parser": ">=5.7.0",
      "fast-uri": ">=4.1.3",
      "socket.io-parser": ">=4.2.7",
      "engine.io": ">=6.6.10",
      "ws": ">=8.21.0",
      "flatted": ">=3.4.2",
      "shell-quote": ">=1.9.0",
      "nanoid": ">=3.3.17",
      "lodash": ">=4.18.0",
      "defu": ">=6.1.5",
      "@babel/core": ">=7.29.6",
      "esbuild": ">=0.28.1",
      "yaml": ">=2.8.3",
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
