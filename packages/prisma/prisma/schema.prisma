generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use pooled connection for runtime queries (can be Supabase Pooler / PgBouncer)
  url       = env("DATABASE_URL")
  // Use direct connection for migrations/introspection (must NOT be PgBouncer)
  directUrl = env("DIRECT_URL")
}

/* ----------------------------
   USER & AUTH MODELS
----------------------------- */

model User {
  id                  String              @id @default(cuid())
  name                String
  passwordHash        String
  email               String              @unique
  role                Role?
  /** When true, this user can only access the admin pages listed in
   *  allowedPages (see apps/web/src/lib/adminPages.ts), narrowed further by
   *  their role's own rank ceiling. When false (default), access is
   *  unrestricted within whatever their role rank already permits.
   *  SUPER_ADMIN/ADMIN always have full access regardless of this flag. */
  pagesRestricted     Boolean             @default(false)
  allowedPages        String[]            @default([])
  phone               String?
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  /** Employee attendance: department/job role assignment, set by an admin. */
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobRoleId    String?
  jobRole      JobRole?    @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  auditLogs           AuditLog[]
  assignedSubmissions ContactSubmission[]

  accounts Account[]
  sessions Session[]

  media     Media[]
  revisions Revision[]

  attendances           Attendance[]
  attendanceCorrections Attendance[]       @relation("AttendanceCorrections")
  attendanceWindowEdits AttendanceWindow[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  STAFF
  VIEWER
  USER
}

/* ----------------------------
   CONTACT SUBMISSIONS
----------------------------- */

model ContactSubmission {
  id           String           @id @default(cuid())
  name         String
  email        String
  phone        String?
  message      String
  source       String?
  createdAt    DateTime         @default(now())

  status       SubmissionStatus @default(new)

  assignedToId String?
  assignedTo   User?            @relation(fields: [assignedToId], references: [id])

  auditLogs    AuditLog[]
  replies      Reply[]
}

enum SubmissionStatus {
  new
  in_review
  responded
  closed
}

/* ----------------------------
   AUDIT LOGS
----------------------------- */

model AuditLog {
  id                  String            @id @default(cuid())
  contactSubmissionId String?
  contactSubmission   ContactSubmission? @relation(fields: [contactSubmissionId], references: [id])

  actorId             String?
  actor               User?             @relation(fields: [actorId], references: [id])

  action              String
  createdAt           DateTime          @default(now())

  meta                Json?
}

/* ----------------------------
   REPLIES
----------------------------- */

model Reply {
  id                  String            @id @default(cuid())
  submissionId        String
  submission          ContactSubmission @relation(fields: [submissionId], references: [id])

  body                String
  channel             ReplyChannel
  sentAt              DateTime          @default(now())

  meta                Json?
}

enum ReplyChannel {
  email
  phone
  whatsapp
  note
}

/* ----------------------------
   NEXTAUTH MODELS
----------------------------- */

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model WebhookAttempt {
  id          String   @id @default(cuid())
  webhookUrl  String
  payload     Json
  status      String   @default("pending") // pending / success / failed
  response    String?  // response text or error (short)
  attempt     Int      @default(0)
  maxAttempts Int      @default(5)
  nextRetryAt DateTime? 
  createdAt   DateTime @default(now())

  @@index([webhookUrl])
  @@index([status])
}

/* ----------------------------
   PRODUCTS & SERVICES
----------------------------- */

model Product {
  id          String      @id @default(cuid())
  name        String
  title       String
  description String?
  price       Float
  images      String[]    @default([])
  type        ProductType @default(PRODUCT)
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum ProductType {
  PRODUCT
  SERVICE
}

/* ----------------------------
   ANNOUNCEMENTS
----------------------------- */

model Announcement {
  id          String            @id @default(cuid())
  title       String
  message     String
  imageUrl    String?
  type        AnnouncementType  @default(info)
  active      Boolean           @default(true)
  dismissible Boolean           @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum AnnouncementType {
  info
  warning
  promo
  success
  error
}

/* ----------------------------
   BLOG POSTS
----------------------------- */

model BlogPost {
  id                 String        @id @default(cuid())
  title              String
  slug               String        @unique
  content            String
  excerpt            String?
  coverImage         String?
  seoTitle           String?
  seoDescription     String?
  published          Boolean       @default(false)
  featured           Boolean       @default(false)
  publishedAt        DateTime?
  locale             BlogLocale    @default(fr)
  categoryId         String?
  category           BlogCategory? @relation(fields: [categoryId], references: [id])
  tags               BlogTag[]
  /** Shared across the fr/en pair of the same article so they can link to each other. */
  translationGroupId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([translationGroupId])
}

model BlogCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameFr    String
  nameEn    String
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[]
}

model BlogTag {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameFr    String
  nameEn    String
  createdAt DateTime   @default(now())
  posts     BlogPost[]
}

enum BlogLocale {
  fr
  en
}

/* ----------------------------
   CMS FOUNDATION (Phase 1)
----------------------------- */

enum BlockType {
  RICHTEXT
  BULLET_LIST
  IMAGE
  VIDEO
}

enum HomepageSectionType {
  HERO
  SERVICES_GRID
  ABOUT
  MAP
  STATS
  PARTNERS
  TESTIMONIALS
}

enum NavLinkType {
  INTERNAL
  EXTERNAL
  SERVICES_DROPDOWN
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  LINKEDIN
  TIKTOK
  X
  YOUTUBE
  OTHER
}

enum RevisionAction {
  CREATE
  UPDATE
  SOFT_DELETE
  RESTORE
}

model Media {
  id           String    @id @default(cuid())
  key          String    @unique
  url          String
  thumbnailUrl String?
  webpUrl      String?
  folder       String    @default("uploads")
  altFr        String?
  altEn        String?
  width        Int?
  height       Int?
  mimeType     String?
  size         Int?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  aboutPageHeroOf   AboutPage[]
  serviceHeroOf     Service[]         @relation("ServiceHeroImage")
  serviceOgOf       Service[]         @relation("ServiceOgImage")
  serviceSectionOf  ServiceSection[]
  homepageSectionOf HomepageSection[]
  settingsLogoOf    SiteSettings[]    @relation("SettingsLogo")
  settingsFaviconOf SiteSettings[]    @relation("SettingsFavicon")
  settingsOgOf      SiteSettings[]    @relation("SettingsOgImage")

  @@index([folder])
}

model Service {
  id               String    @id @default(cuid())
  slug             String    @unique
  titleFr          String
  titleEn          String
  summaryFr        String
  summaryEn        String
  heroImageId      String?
  heroImage        Media?    @relation("ServiceHeroImage", fields: [heroImageId], references: [id])
  ogImageId        String?
  ogImage          Media?    @relation("ServiceOgImage", fields: [ogImageId], references: [id])
  seoTitleFr       String?
  seoTitleEn       String?
  seoDescriptionFr String?
  seoDescriptionEn String?
  order            Int       @default(0)
  featured         Boolean   @default(false)
  published        Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?
  updatedById      String?

  sections ServiceSection[]

  @@index([published, deletedAt, order])
}

model ServiceSection {
  id        String    @id @default(cuid())
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  key       String
  type      BlockType @default(BULLET_LIST)
  titleFr   String
  titleEn   String
  bodyFr    String?
  bodyEn    String?
  itemsFr   String[]  @default([])
  itemsEn   String[]  @default([])
  videoUrl  String?
  mediaId   String?
  media     Media?    @relation(fields: [mediaId], references: [id])
  order     Int       @default(0)
  visible   Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([serviceId, key])
  @@index([serviceId, order])
}

model HomepageSection {
  id         String              @id @default(cuid())
  key        String              @unique
  type       HomepageSectionType
  titleFr    String?
  titleEn    String?
  subtitleFr String?
  subtitleEn String?
  bodyFr     String?
  bodyEn     String?
  mediaId    String?
  media      Media?              @relation(fields: [mediaId], references: [id])
  ctaLabelFr String?
  ctaLabelEn String?
  ctaHref    String?
  data       Json?
  order      Int                 @default(0)
  visible    Boolean             @default(true)
  deletedAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([order])
}

model SiteSettings {
  id                       String   @id @default("singleton")
  companyNameFr            String
  companyNameEn            String
  taglineFr                String?
  taglineEn                String?
  addressFr                String?
  addressEn                String?
  city                     String?
  country                  String?
  phonePrimary             String?
  phoneSecondary           String?
  whatsapp                 String?
  emailPrimary             String?
  emailContact             String?
  mapEmbedUrl              String?
  mapPlaceUrl              String?
  latitude                 Float?
  longitude                Float?
  businessHoursFr          String?
  businessHoursEn          String?
  logoId                   String?
  logo                     Media?   @relation("SettingsLogo", fields: [logoId], references: [id])
  faviconId                String?
  favicon                  Media?   @relation("SettingsFavicon", fields: [faviconId], references: [id])
  defaultSeoTitleFr        String?
  defaultSeoTitleEn        String?
  defaultSeoDescriptionFr  String?
  defaultSeoDescriptionEn  String?
  defaultOgImageId         String?
  defaultOgImage           Media?   @relation("SettingsOgImage", fields: [defaultOgImageId], references: [id])
  googleSiteVerification   String?
  analyticsId              String?
  smtpFromName             String?
  smtpFromEmail            String?
  smtpReplyTo              String?
  updatedAt                DateTime @updatedAt
  updatedById              String?
}

model NavigationItem {
  id           String           @id @default(cuid())
  key          String?          @unique
  labelFr      String
  labelEn      String
  href         String?
  linkType     NavLinkType      @default(INTERNAL)
  parentId     String?
  parent       NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id])
  children     NavigationItem[] @relation("NavChildren")
  order        Int              @default(0)
  visible      Boolean          @default(true)
  openInNewTab Boolean          @default(false)
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([parentId, order])
}

model SocialLink {
  id        String         @id @default(cuid())
  key       String?        @unique
  platform  SocialPlatform
  label     String?
  url       String
  order     Int            @default(0)
  visible   Boolean        @default(true)
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([order])
}

model AboutPage {
  id               String   @id @default("singleton")
  titleFr          String
  titleEn          String
  introFr          String
  introEn          String
  bodyFr           String
  bodyEn           String
  heroImageId      String?
  heroImage        Media?   @relation(fields: [heroImageId], references: [id])
  seoTitleFr       String?
  seoTitleEn       String?
  seoDescriptionFr String?
  seoDescriptionEn String?
  updatedAt        DateTime @updatedAt
  updatedById      String?
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(308)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active])
}

model Revision {
  id          String         @id @default(cuid())
  entityType  String
  entityId    String
  action      RevisionAction
  snapshot    Json
  createdAt   DateTime       @default(now())
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id])

  @@index([entityType, entityId, createdAt])
}

/* ----------------------------
   EMPLOYEE ATTENDANCE
----------------------------- */

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees        User[]
  jobRoles         JobRole[]
  attendanceWindow AttendanceWindow?
  attendances      Attendance[]
}

model JobRole {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employees   User[]
  attendances Attendance[]

  @@unique([departmentId, name])
}

/**
 * The configurable attendance time window for a department (see PRD:
 * "Attendance must NOT use a single hard-coded arrival time"). A row with
 * departmentId = null is the fallback window used by any department that
 * hasn't configured its own — every attendance calculation resolves a
 * window through this fallback chain, never a hard-coded time.
 */
model AttendanceWindow {
  id                 String      @id @default(cuid())
  departmentId       String?     @unique
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  windowStartMinutes Int
  windowEndMinutes   Int
  updatedAt          DateTime    @updatedAt
  updatedById        String?
  updatedBy          User?       @relation(fields: [updatedById], references: [id])
}

enum AttendanceStatus {
  ON_TIME
  LATE
}

enum AttendanceSource {
  QR
  MANUAL
}

model Attendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobRoleId    String?
  jobRole      JobRole?    @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
  /** Snapshots of the employee's department/role name at the time of this
   *  record, so historical rows keep reading correctly even if the employee
   *  is later reassigned or the department/role is renamed or removed. */
  departmentName String?
  jobRoleName    String?

  /** Calendar day this attendance belongs to (app timezone), stored as a
   *  pure date so one (userId, date) pair can never carry two records. */
  date        DateTime          @db.Date
  arrivalAt   DateTime
  departureAt DateTime?
  status      AttendanceStatus
  source      AttendanceSource  @default(QR)

  note          String?
  correctedById String?
  correctedBy   User?     @relation("AttendanceCorrections", fields: [correctedById], references: [id])
  correctedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([departmentId, date])
  @@index([status, date])
  @@index([date])
}
